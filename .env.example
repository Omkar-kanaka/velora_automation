GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# OpenRouter API Key
OPENROUTER_API_KEY=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Nvidia NIM / LiteLLM API Key
NVIDIA_NIM_API_KEY=
